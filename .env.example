# Node/Express. Use NODE_ENV=production for the compiled server.
# Browser code currently needs no environment variables. Any future public setting
# must use import.meta.env.VITE_*; process.env is only available in Node tooling/server.
NODE_ENV=development
PORT=3000
# Contenedor detrás de proxy TLS: IP/CIDR exactos del proxy, separados por comas.
# Dejar vacío para conexión directa. Nunca usar true ni 0.0.0.0/0.
TRUST_PROXY=
# Public origin only: no path/trailing slash. Production Webpay requires HTTPS.
# On Render, omit APP_URL to use the automatic RENDER_EXTERNAL_URL.
APP_URL=http://localhost:3000

# Webpay Plus (SDK oficial) o Mercado Pago Checkout Pro.
# Si se configuran ambos, MERCADOPAGO_ACCESS_TOKEN tiene prioridad.
# sandbox = Transbank integration (test credentials); production = actual charges.
# Sin token MP ni ambas credenciales Webpay se activa el simulador.
# Invalid configured credentials cause an error, NEVER a simulated success.
PAYMENT_ENV=sandbox
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
PAYMENT_TIMEOUT_MS=10000
# For production, REQUIRED absolute path on a PERSISTENT disk.
# Render config sets /var/data/payments. Locally defaults to .data/payments.
# One Node process/instance. Sandbox and production records are isolated.
PAYMENT_STORE_DIR=
# Official callback registered in transaction.create, not a browser-supplied URL:
# APP_URL/api/webhooks/payment (GET or POST, including URL-encoded forms).
# Real payments are verified with SDK commit/status, not this mock secret.
PAYMENT_WEBHOOK_SECRET=
# Exact additional browser origins, comma-separated, no wildcard or trailing slash.
# The APP_URL origin is automatically allowed. Usually empty for same-origin SPA.
CORS_ALLOWED_ORIGINS=
# Mercado Pago: usar token de pruebas en sandbox y token real en production.
# Token presente exige webhook secret, Supabase y Redis; errores NO activan el mock.
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones > Webhooks: registrar APP_URL/api/webhooks/mercadopago (pagos).
# Secret de firma, NO el access token. Firmas x-signature y x-request-id.
MERCADOPAGO_WEBHOOK_SECRET=
# Redis privado. SET lock:webhook:mp:{payment_id} NX EX 60; liberar solo dueño.
REDIS_URL=
# Supabase HTTPS. Ejecutar supabase/migrations/202609190001_payment_orders.sql.
# SUPABASE_SERVICE_ROLE_KEY se define abajo; nunca exponer al frontend.
SUPABASE_URL=

# Gemini secrets remain server-side; blank key enables local FAQ/reference fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_COOLDOWN_MS=60000

# Supabase requerido por /health y pagos MP. También persiste eventos opcionales.
# Alias heredado de SUPABASE_URL; preferir SUPABASE_URL y no configurar URLs distintas.
NEXT_PUBLIC_SUPABASE_URL=
# Alias público heredado validado por el servidor; la aplicación no lo necesita.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token for server-to-server POST /api/v1/events.
EVENTS_API_TOKEN=
# Never prefix payment, Gemini or Supabase service credentials with VITE_.

# Trazabilidad Ley N° 21.713 / SII (reglas operativas, no variables ficticias):
# Conservar vínculo orden UUID -> payment_id -> fecha -> monto CLP/neto/IVA -> DTE.
# payment_audit registra transiciones atómicamente; RLS bloquea anon/authenticated.
# Conciliar con liquidaciones del proveedor y registrar folio/tipo/fecha del DTE
# en el sistema tributario del comercio. ready_for_issuance NO es un DTE emitido.
# Verificar inicio de actividades y aplicar obligaciones según el rol del comercio,
# plataforma u operador; esta integración no reporta al SII ni emite DTE.
# Definir acceso, respaldos y retención con el responsable tributario del comercio.
# Fuente: https://www.sii.cl/destacados/ley_cumplimiento_obligaciones_tributarias/quienes_deben_inicio.html

# Variables inyectadas por Render (no completar localmente): RENDER=true,
# RENDER_EXTERNAL_URL=https://servicio.onrender.com.
# Solo desarrollo Vite: DISABLE_HMR=true desactiva HMR y vigilancia de archivos.
# /health y /api/health: 200 SOLO si Supabase (payment_orders) y Redis responden.
# Ausencia/fallo devuelve 503 incluso en demo; /live solo confirma proceso activo.
